# Intervals.icu
INTERVALS_ATHLETE_ID=i00000
INTERVALS_API_KEY=your_intervals_api_key_here

# Anthropic
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Email reminders (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
REMINDER_EMAIL=your_email@gmail.com

# App
APP_URL=http://localhost:8000
SECRET_KEY=change-this-to-a-random-string

# Database — local default is coach.db in project root.
# On Railway, set to /data/coach.db and attach a persistent volume at /data.
DATABASE_PATH=coach.db
